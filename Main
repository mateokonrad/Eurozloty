<body>

<div class="box">
    <h2>💱 EUR ⇄ PLN</h2>

    <input type="number" id="amount" placeholder="Kwota" value="100">

    <select id="direction">
        <option value="EURPLN">EUR → PLN</option>
        <option value="PLNEUR">PLN → EUR</option>
    </select>

    <button onclick="convert()">Przelicz</button>

    <div id="rate">Pobieranie kursu...</div>
    <div id="result"></div>
</div>

<script>
let eurPln = null;

async function loadRate() {
    try {

        // Darmowe API bazujące na danych ECB
        const res = await fetch(
            "https://api.frankfurter.app/latest?from=EUR&to=PLN"
        );

        const data = await res.json();

        eurPln = data.rates.PLN;

        document.getElementById("rate").innerHTML =
            `1 EUR = ${eurPln.toFixed(4)} PLN`;
    } catch(e) {
        document.getElementById("rate").innerHTML =
            "Nie udało się pobrać kursu.";
    }
}

function convert() {

    if(!eurPln){
        alert("Kurs jeszcze się ładuje.");
        return;
    }

    const amount = parseFloat(
        document.getElementById("amount").value
    );

    const direction =
        document.getElementById("direction").value;

    let result;

    if(direction === "EURPLN"){
        result = amount * eurPln;
        document.getElementById("result").innerHTML =
            `${amount} EUR = ${result.toFixed(2)} PLN`;
    } else {
        result = amount / eurPln;
        document.getElementById("result").innerHTML =
            `${amount} PLN = ${result.toFixed(2)} EUR`;
    }
}

loadRate();
</script>

</body>
</html>
